{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://buzonxpress.alwaysdata.net"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "24.22.2"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://buzonxpress.alwaysdata.net"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "node": "24.22.2"
    }
  }
}
