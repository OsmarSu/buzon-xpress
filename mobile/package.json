{
  "name": "buzon-xpress-mobile",
  "version": "0.2.5",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.33",
    "expo-build-properties": "~57.0.24",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "android": "node scripts/start.mjs --android",
    "ios": "expo start --ios",
    "web": "node scripts/start.mjs --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:web": "expo export --platform web --output-dir dist/web",
    "preview": "node scripts/preview.mjs",
    "lint": "expo lint --no-cache --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm test",
    "postinstall": "node scripts/prepare-dependencies.mjs",
    "eas-build-post-install": "npm run check"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.8"
    },
    "@expo/ngrok": {
      "uuid": "11.1.1"
    },
    "query-string": {
      "decode-uri-component": "0.5.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
